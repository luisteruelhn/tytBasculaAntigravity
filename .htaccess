<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a carpetas internas, código fuente, scripts y archivos sensibles
    RewriteRule ^(\.git|\.agents|\.runtime|\.venv|api|scripts|dbbackup|runtime|web/config|web/src)(/|$) - [F,L,NC]
    RewriteRule \.(md|sql|py|cmd|json|bak|log|env|ini)$ - [F,L,NC]

    # Asegurar barra final en /bascula para que rutas relativas (assets/css, js, login.php) carguen siempre bien
    RewriteRule ^bascula$ /bascula/ [R=301,L]
    RewriteRule ^bascula/$ web/public/index.php [L]
    RewriteRule ^bascula/(.+)$ web/public/$1 [L,QSA]
</IfModule>

Options -Indexes
